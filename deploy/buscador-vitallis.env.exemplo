# Copie para /etc/buscador-vitallis.env e preencha. Permissão: chmod 600, dono root.
GOOGLE_MAPS_API_KEY=cole_a_chave_aqui
# Limite de buscas novas por dia, somando todos os visitantes (15 fica dentro da cota grátis do Google)
MAX_BUSCAS_DIA=15
# Opcional: exige senha para usar o buscador
# APP_SENHA=
